# apps/frontend — Expo public config. Copy to .env for local dev.
# EXPO_PUBLIC_* is inlined into the bundle at build time (never put secrets here).

# Base URL of the proof api (apps/api). The queue POSTs pending proofs to ${EXPO_PUBLIC_API_URL}/sync.
# Deployed value: https://prufture-api.onrender.com (set in eas.json for preview/production builds).
# Local dev default when unset: http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Public verify page base, used to build the shareable verifyUrl. Deployed: https://prufture.voltarut.com/verify
EXPO_PUBLIC_VERIFY_URL=

# X25519 PUBLIC key (hex, 32 bytes) the app seals the precise location point and any
# shared evidence photo to (photos only on per-report opt-in or an approved request).
# The matching PRIVATE key stays with the programme team and never enters the repo,
# the app, or the api. The value below is a throwaway demo key — a real deployment
# swaps in the programme team's public key.
EXPO_PUBLIC_PROGRAMME_PUBKEY=5e2dbae8ea6326921962f0e3e0a68d5db35fdf10bd5c70a870e94e8d47262e7b

# Copy only: the retention the app tells reporters about. Keep equal to the api's
# EVIDENCE_RETENTION_DAYS. Unset -> 90.
EXPO_PUBLIC_EVIDENCE_RETENTION_DAYS=90

# RevenueCat TEST STORE key (test_...). Platform-agnostic, needs no App Store / Play setup, and
# takes precedence over the platform keys. Purchases made with it are NOT real revenue — it proves
# our integration only, never Apple's or Google's. NEVER set this in a production build.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
# Platform-specific PUBLIC SDK keys. These ship in the client on purpose. The SECRET key (sk_...)
# is server-side only and must NEVER appear in this bundle.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# OneSignal app id (public, a UUID from OneSignal → Settings → Keys & IDs). Unset or malformed ->
# push stays off. Also set it in the EAS build profile's env (eas.json) for store builds.
EXPO_PUBLIC_ONESIGNAL_APP_ID=
