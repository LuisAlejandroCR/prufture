{
  "expo": {
    "name": "Prufture",
    "slug": "prufture",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "proofatcapture",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Prufture uses the camera to photograph field-task evidence." }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Prufture records a coarse capture location for verification." }]
    ],
    "ios": { "supportsTablet": true, "bundleIdentifier": "ai.proofatcapture.app" },
    "android": { "package": "ai.proofatcapture.app" },
    "extra": { "eas": { "projectId": "" } }
  }
}
