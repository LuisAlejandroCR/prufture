{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": true
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": false,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "<<api url>>",
        "EXPO_PUBLIC_PROGRAMME_PUBKEY": "5e2dbae8ea6326921962f0e3e0a68d5db35fdf10bd5c70a870e94e8d47262e7b"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "developmentClient": false,
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
