{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": true
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": false,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://prufture-api.onrender.com",
        "EXPO_PUBLIC_VERIFY_URL": "https://prufture.vercel.app/verify",
