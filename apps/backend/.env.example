# apps/backend/.env.example: copy to .env.local and fill in. Every value is optional: the public
# verifier, site and dashboard run with none of them against a local api on :8787.
# NEXT_PUBLIC_* values are compiled into the browser bundle; never put a secret in one.

# Where the verifier and dashboard read reports from (apps/api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Base of the public record links (/verify/<hash>) and share codes.
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000
# Absolute base for link previews (opengraph-image). Default: https://prufture.voltarut.com
NEXT_PUBLIC_SITE_URL=
# Landing page extras: the sample record it links to, and an Android build link.
NEXT_PUBLIC_SAMPLE_HASH=
NEXT_PUBLIC_ANDROID_BUILD_URL=

# /support contact (the App Store support URL). With both unset the page says a contact is being
# set up rather than printing a fake one.
NEXT_PUBLIC_SUPPORT_EMAIL=
# International number, e.g. +57 301 393 5156.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Staff sign-in for /dashboard (Clerk). Without both keys every request passes and the dashboard
# shows a "not configured" banner.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Invitation codes staff redeem after signing in (comma or newline separated, 8+ characters).
# Unset: signed-in staff reach the dashboard without a code.
STAFF_INVITE_CODES=

# Server-only: the RevenueCat app user id holding coordinator_pro that the dashboard calls the
# coordinator API as (phone enrolment for the programme pass). Not the programme id.
COORDINATOR_APP_USER_ID=
