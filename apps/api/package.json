{
  "name": "@proof/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "shadow-compare": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/shadow-compare.ts",
    "rpc-check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/rpc-check.ts",
    "submitter-sandbox": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/submitter-sandbox.ts",
    "register-schema": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/register-schema.ts",
    "test": "node --import tsx --test --test-concurrency=1 $(find test -name \"*.test.ts\")",
    "personhood-fixtures": "tsx scripts/make-personhood-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1142.0",
    "@hono/node-server": "^1.13.0",
    "@proof/core": "*",
    "@semaphore-protocol/group": "^4.14.3",
    "@semaphore-protocol/proof": "^4.14.3",
    "hono": "^4.6.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@semaphore-protocol/identity": "^4.14.3",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
