# apps/api/.env.example: copy to .env and fill in. Every value is optional —
# a missing value degrades that feature, it never crashes the server.

PORT=8787
VERIFY_BASE_URL=http://localhost:3000

# On-chain attestation (Base Sepolia). Any JSON-RPC endpoint for the chain works; the relayer
# degrades to a typed unavailable if unset. DWELLIR_RPC_URL is a deprecated fallback name.
RPC_URL=
DWELLIR_RPC_URL=
RELAYER_PRIVATE_KEY=
# Submitter adapter: "local-key" (default) or "none". Unknown names fail closed to "none".
ATTESTATION_SUBMITTER=local-key
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
EAS_SCHEMA_UID=
BASE_SEPOLIA_CHAIN_ID=84532

# Neuro Agent API (verified attribute + selfie liveness). Both degrade if unset.
NEURO_AGENT_API_URL=
NEURO_AGENT_API_TOKEN=
NEURO_LIVENESS_PATH=/liveness

# RevenueCat server-side entitlement check (coordinator paywall). Secret key only, never
# sent to the client. Degrades if unset.
REVENUECAT_SECRET_KEY=
REVENUECAT_API_BASE=https://api.revenuecat.com/v2
# RevenueCat v2 endpoints are project-scoped (/v2/projects/<id>/customers/...). Dashboard:
# Project settings -> the project id looks like proj1ab2c3d4. Without it the entitlement
# check degrades typed and every coordinator route returns 503.
REVENUECAT_PROJECT_ID=
