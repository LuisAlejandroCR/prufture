# apps/api/.env.example: copy to .env and fill in. Every value is optional —
# a missing value degrades that feature, it never crashes the server.

PORT=8787
VERIFY_BASE_URL=http://localhost:3000

# On-chain attestation (Base Sepolia). Any JSON-RPC endpoint for the chain works; the relayer
# degrades to a typed unavailable if unset. DWELLIR_RPC_URL is a deprecated fallback name.
# e.g. CDP Node: copy the Base Sepolia URL from the CDP portal (Node page); the key is in its path.
RPC_URL=
# Extra endpoints, comma-separated, tried in order on failure. Vet with: npm run rpc-check
RPC_FALLBACK_URLS=
DWELLIR_RPC_URL=
RELAYER_PRIVATE_KEY=
# Submitter adapter: "local-key" (default), "openzeppelin-relayer", or "none". Unknown names
# fail closed to "none".
ATTESTATION_SUBMITTER=local-key
# Only for ATTESTATION_SUBMITTER=openzeppelin-relayer: the relayer holds the key, not this process.
# OZ_RELAYER_ADDRESS pins the relayer's signer address; any other address is refused, and so is a
# relayer whose policies.whitelist_receivers is not exactly the EAS contract. Local sandbox: sandbox/up.sh
OZ_RELAYER_URL=
OZ_RELAYER_ID=
OZ_RELAYER_API_KEY=
OZ_RELAYER_ADDRESS=
OZ_RELAYER_NETWORK=base-sepolia
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
EAS_SCHEMA_UID=
BASE_SEPOLIA_CHAIN_ID=84532

# Selfie liveness: OFF. "none" is the only adapter; any other name resolves to "none".
LIVENESS_PROVIDER=none

# RevenueCat server-side entitlement check (coordinator paywall). Secret key only, never
# sent to the client. Degrades if unset.
REVENUECAT_SECRET_KEY=
REVENUECAT_API_BASE=https://api.revenuecat.com/v2
# RevenueCat v2 endpoints are project-scoped (/v2/projects/<id>/customers/...). Dashboard:
# Project settings -> the project id looks like proj1ab2c3d4. Without it the entitlement
# check degrades typed and every coordinator route returns 503.
REVENUECAT_PROJECT_ID=

# Sealed evidence photos. Sent only when a reporter opts in per report, or approves a coordinator's
# request in the app. Sealed on the device to EXPO_PUBLIC_PROGRAMME_PUBKEY; this api stores opaque
# ciphertext only. "none" (default) keeps every evidence route typed-unavailable. "s3" = any
# S3-compatible bucket (Cloudflare R2, AWS S3, MinIO), path-style. Keys go in the host's secret
# store, never in the repo.
EVIDENCE_STORAGE=none
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=
# R2 uses "auto"; AWS uses the bucket's region.
EVIDENCE_S3_REGION=auto
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
# Sealed blobs are deleted this many days after upload (purge runs at start-up and every 6 h).
EVIDENCE_RETENTION_DAYS=90
# Max sealed bytes per photo (5 MiB).
EVIDENCE_MAX_BYTES=5242880
