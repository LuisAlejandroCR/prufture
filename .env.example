# Copy to .env in each app that needs it. Never commit real values (AGENTS.md rule).
#
# Deploy (see vercel.json / render.yaml):
#   apps/backend -> Vercel. Set NEXT_PUBLIC_API_BASE_URL = the Render api URL and
#     NEXT_PUBLIC_VERIFY_BASE_URL = the Vercel URL itself, both as Vercel project env vars.
#   apps/api -> Render (persistent disk). Set VERIFY_BASE_URL = the Vercel URL and
#     STORE_PATH = /data/store.json on the mounted disk.
#   apps/frontend -> EXPO_PUBLIC_API_URL is baked into the preview APK via eas.json.

# apps/api — relayer + on-chain attestation
# RELAYER_PRIVATE_KEY signs attest() calls ONLY — it must never hold funds beyond gas.
# RPC_URL is any Base Sepolia JSON-RPC endpoint — the provider is a config choice, not a code
# change. https://sepolia.base.org works for development; pick a managed endpoint for a pilot.
RPC_URL=
# DEPRECATED: the former vendor-specific name. Still honoured if RPC_URL is unset; remove it once
# your deployment has moved over.
DWELLIR_RPC_URL=
RELAYER_PRIVATE_KEY=
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
# Register once: npm run register-schema --workspace apps/api (needs funded key + RPC).
# Paste the printed UID here. Never commit the real value.
EAS_SCHEMA_UID=
BASE_SEPOLIA_CHAIN_ID=84532
# Durable proof store. File-backed JSON; needs a persistent writable disk (Render disk, Railway/Fly
# volume), NOT Vercel serverless. Defaults to ./.data/store.json (relative to the apps/api cwd).
STORE_PATH=./.data/store.json

# apps/api — push tokens (POST /register-push). No key: tokens are stored anonymously against a
# random device id, in memory, never linked to a proof or an identity. Server-sent push is not
# wired in this pass (docs/store_listing.md) — the app fires a local "confirmed" notification.

# apps/api — identity, degrades if absent
# Assurance is OPTIONAL and defaults OFF (provider portability plan, phase 3). Liveness and
# verified attributes are SEPARATE ports: a liveness vendor is not an attribute issuer.
# "none" (default) or "neuro". An unknown name fails closed to "none" — setting the vendor
# credentials below is NOT enough to switch either port on.
LIVENESS_PROVIDER=none
ATTRIBUTE_PROVIDER=none
NEURO_AGENT_API_URL=
NEURO_AGENT_API_TOKEN=

# apps/api — RevenueCat server-side entitlement check (coordinator paywall). Server secret
# only, never sent to the client. Degrades if absent.
REVENUECAT_SECRET_KEY=
REVENUECAT_API_BASE=https://api.revenuecat.com/v2
# RevenueCat v2 endpoints are project-scoped (/v2/projects/<id>/customers/...). Dashboard:
# Project settings -> the project id looks like proj1ab2c3d4. Without it the entitlement
# check degrades typed and every coordinator route returns 503.
REVENUECAT_PROJECT_ID=

# apps/frontend — RevenueCat PUBLIC API key (safe client-side). Read by src/purchases.ts.
# RevenueCat PUBLIC SDK keys — one per platform. These ship in the client on purpose.
# The SECRET key (sk_...) is server-side only (REVENUECAT_SECRET_KEY above) and must NEVER
# appear in the mobile bundle.
# RevenueCat TEST STORE key (test_...). Platform-agnostic, needs no App Store / Play setup, and
# takes precedence over the two platform keys below. Purchases made with it are NOT real revenue.
# NEVER set this in a production build.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# apps/api — delivery channels, all optional / degrade. Each channel sends only the verifyUrl.
# Kapso / WhatsApp
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_API_BASE=https://app.kapso.ai/api/v1
# Email (Resend-compatible)
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_BASE=https://api.resend.com
# Telegram (optional)
TELEGRAM_BOT_TOKEN=
# Base URL used to build the shared verifyUrl in POST /notify
VERIFY_BASE_URL=http://localhost:3000

# apps/api — automatic programme notification on sync (best-effort, url-only, deduped per report).
# The recipient is the PROGRAMME TEAM, fixed here — NEVER a reporter. Nothing here is a reporter's
# contact; the app never sends a phone or email and none is stored against a reporter.
NOTIFY_ENABLED=false
# When to fire: sync (report received) | attest (a confirmation landed) | both. Default: sync.
NOTIFY_ON=sync
PROGRAMME_WHATSAPP=
PROGRAMME_EMAIL=

# apps/web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000

# apps/mobile — EXPO_PUBLIC_API_URL is read by the client sync module and inlined at build
# time (eas.json `preview.env` for the demo APK). Local dev falls back to localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
# apps/frontend — selfie/liveness step in the default reporter journey. "on" inserts the
# identity screen after permissions; anything else (unset, "off") skips straight to capture
# and never sends a face frame. Default off.
EXPO_PUBLIC_IDENTITY_STEP=off
